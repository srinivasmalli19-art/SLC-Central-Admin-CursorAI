# ============================================================================
# SLC Central Admin — example environment configuration
# ----------------------------------------------------------------------------
# Copy this file to `.env` and fill in values for your local environment.
#   cp .env.example .env
#
# NEVER commit a real `.env` file or any production credentials.
# This file contains PLACEHOLDERS ONLY.
# ============================================================================

# ---- Runtime -----------------------------------------------------------------
# One of: development | staging | production
NODE_ENV=development

# Port the Central Admin API listens on.
PORT=4000

# Public base URL of the Central Admin API (used by the web app / CORS).
API_BASE_URL=http://localhost:4000

# Public base URL of the Central Admin web application (used for CORS allow-list).
WEB_BASE_URL=http://localhost:5173

# ---- Database (PostgreSQL) ---------------------------------------------------
# Connection string for the CENTRAL admin PostgreSQL database.
# This database holds ONLY central administration data and is independent of
# every external application database.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://slc_admin:change_me@localhost:5432/slc_central_admin?schema=public

# ---- Logging -----------------------------------------------------------------
# One of: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ---- Session / cookie security (Phase 2) -------------------------------------
# Name of the httpOnly session cookie.
SESSION_COOKIE_NAME=slc_admin_session
# Session lifetime in hours.
SESSION_TTL_HOURS=12
# Whether cookies carry the `Secure` attribute. Explicit and validated: it
# MUST be true in production/staging. Locally over http you may set it to false.
COOKIE_SECURE=false
# SameSite policy for cookies: strict | lax | none (none requires COOKIE_SECURE=true).
COOKIE_SAMESITE=strict
# Optional explicit cookie domain (e.g. admin.slcvet.com). Leave unset locally.
# COOKIE_DOMAIN=

# ---- Auth rate limiting ------------------------------------------------------
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MIN=15

# ---- Central SSO (Keycloak / OpenID Connect) ---------------------------------
# Set all three to turn on "Sign in with SLC Account". Values below match the
# LOCAL dev realm in infra/keycloak/realm-slc.json. In production use an https
# issuer and a freshly generated client secret from your secret manager.
# OIDC_ISSUER_URL=http://localhost:8080/realms/slc
# OIDC_CLIENT_ID=central-admin
# OIDC_CLIENT_SECRET=dev-only-central-admin-secret-change-me
# Optional overrides (defaults shown):
# OIDC_REDIRECT_URI=http://localhost:5173/api/v1/auth/oidc/callback
# OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/login
# OIDC_ROLES_CLAIM=roles
# OIDC_SCOPES=openid email profile
# OIDC_PROVIDER_NAME=SLC Account
# Email + password login: defaults to false when SSO is configured, true otherwise.
# Set to true during migration or to keep a break-glass local login.
# PASSWORD_LOGIN_ENABLED=false

# ---- Admin access management (Keycloak Admin API) ----------------------------
# Service account client allowed to manage SLC admin users and their app roles.
# Base URL and realm are derived from OIDC_ISSUER_URL unless set explicitly.
# KEYCLOAK_ADMIN_CLIENT_ID=central-admin-api
# KEYCLOAK_ADMIN_CLIENT_SECRET=dev-only-central-admin-api-secret-change-me
# KEYCLOAK_BASE_URL=http://localhost:8080
# KEYCLOAK_REALM=slc
# KEYCLOAK_SEND_INVITE_EMAIL=true

# ---- Firebase-backed SLC apps (Pasumithra, JeevaMitra, Pasunestam) -----------
# Service accounts (JSON or base64 JSON) live only here, never in an app.
# FIREBASE_SA_PASUMITHRA=
# FIREBASE_SA_JEEVAMITRA=
# FIREBASE_SA_PASUNESTAM=
# "origins" = browser origins allowed to call the sign-in bridge (Pasumithra
# admin portal). Entries without origins are used server-side only.
# FIREBASE_BRIDGE_APPS=[{"clientId":"pasumithra-admin","serviceAccountEnv":"FIREBASE_SA_PASUMITHRA","origins":["http://localhost:3001"]},{"clientId":"jeevamitra-admin","serviceAccountEnv":"FIREBASE_SA_JEEVAMITRA"},{"clientId":"pasunestam-admin","serviceAccountEnv":"FIREBASE_SA_PASUNESTAM"}]
FIREBASE_BRIDGE_APPS=[]

# ---- NearSip (Supabase) -------------------------------------------------------
# Service-role key bypasses row-level security: server only, never in an app.
# NEARSIP_SUPABASE_URL=https://<project>.supabase.co
# NEARSIP_SUPABASE_SERVICE_ROLE_KEY=

# ---- Bootstrap the first SUPER_ADMIN (development) ---------------------------
# Used ONLY by `npm run bootstrap:admin`. Never commit real values. If unset,
# the bootstrap script prompts interactively. There is NO default password.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=

# ---- Integration egress allow-list (Phase 5A) --------------------------------
# Comma-separated hostnames that integration adapters may contact. FAIL-CLOSED:
# leave empty so no outbound host is permitted until explicitly configured in a
# future approved phase. Example placeholder only — NOT a real Stock Management
# host (its deployed API host is currently UNKNOWN):
# INTEGRATION_EGRESS_ALLOWLIST=api.example.com,stock-staging.example.com
INTEGRATION_EGRESS_ALLOWLIST=

# ---- Testing -----------------------------------------------------------------
# Connection string for a LOCAL throwaway database used by integration tests.
# When unset, auth/RBAC integration suites are skipped (unit tests still run).
# TEST_DATABASE_URL=postgresql://user:password@localhost:5432/slc_central_admin_test?schema=public
