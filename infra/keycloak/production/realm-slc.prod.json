    {
      "clientId": "central-admin-api",
      "name": "Central Admin identity management",
      "description": "Service account used by the Central Admin API to manage SLC admin users and their app roles (Keycloak Admin API). No browser login.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KC_SECRET_CENTRAL_ADMIN_API}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "redirectUris": [],
