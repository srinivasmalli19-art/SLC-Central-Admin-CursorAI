    {
      "clientId": "pasunestam-admin",
      "name": "Pasunestam admin",
      "description": "Public client used server-side by Pasunestam (Next.js) with PKCE for staff sign-in (roles admin / editor).",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "${PASUNESTAM_URL}/auth/slc/callback",
        "https://pasunestam.com/auth/slc/callback"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${PASUNESTAM_URL}/##https://pasunestam.com/",
        "backchannel.logout.url": "${CENTRAL_ADMIN_API_URL}/api/v1/bridge/firebase/pasunestam-admin/backchannel-logout",
        "backchannel.logout.session.required": "true"
      },
      "protocolMappers": [
        {
          "name": "pasunestam-admin roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
